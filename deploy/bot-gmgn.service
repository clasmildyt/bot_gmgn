[Unit]
Description=GMGN Solana trend screener (Telegram alerts)
Documentation=https://github.com/your-user/your-repo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botgmgn
Group=botgmgn
WorkingDirectory=/opt/bot-gmgn
ExecStart=/usr/bin/node src/index.js --config ./config.yaml
Restart=always
RestartSec=10
TimeoutStopSec=20
Environment=NODE_ENV=production
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/bot-gmgn/data

[Install]
WantedBy=multi-user.target
